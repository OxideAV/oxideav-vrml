#VRML V2.0 utf8
PROTO ColoredBox [
  field SFColor boxColor 0.5 0.5 0.5
  exposedField SFVec3f boxSize 1 1 1
  exposedField SFVec3f position 0 0 0
] {
  Transform {
    translation IS position
    children Shape {
      appearance Appearance { material Material { diffuseColor IS boxColor } }
      geometry Box { size IS boxSize }
    }
  }
}
PROTO Pair [ field SFColor c 1 1 1 ] {
  Group { children [
    ColoredBox { boxColor IS c position -1 0 0 }
    ColoredBox { boxColor IS c position 1 0 0 boxSize 0.5 0.5 0.5 }
  ] }
}
EXTERNPROTO Remote [ exposedField SFFloat weight ] [ "lib.wrl#Remote" "http://example.com/lib.wrl#Remote" ]
DEF A ColoredBox { boxColor 1 0 0 position 0 2 0 }
Pair { c 0 0 1 }
Remote { weight 2 }
