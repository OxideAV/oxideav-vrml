#VRML V2.0 utf8 hand-written fixture: primitives, transforms, DEF/USE
# Each analytic primitive with spec dimensions, inside Transforms.
WorldInfo { title "Primitives" info [ "clean-room fixture" ] }
DEF RED Appearance { material DEF RedMat Material { diffuseColor 1 0 0 shininess 0.5 } }
Transform {
  translation -3 0 0
  children Shape { appearance USE RED geometry Box { size 1 2 3 } }
}
DEF BALL Transform {
  translation 0 0 0
  rotation 0 1 0 1.5707963
  scale 2 2 2
  children Shape { appearance USE RED geometry Sphere { radius 0.5 } }
}
Transform {
  translation 3 0 0
  children [
    Shape { geometry Cone { bottomRadius 1 height 2 bottom FALSE } }
    Transform { translation 0 3 0 children Shape { geometry Cylinder { radius 0.5 height 1 top FALSE } } }
  ]
}
Transform { translation 0 5 0 children USE BALL }
